{
    "name": "node-datalith",
    "version": "0.4.0",
    "description": "A Node.js client for Datalith file storage, media processing, and HLS delivery.",
    "keywords": [
        "datalith",
        "file",
        "oss",
        "sqlite",
        "storage"
    ],
    "homepage": "https://magiclen.org/datalith/",
    "bugs": {
        "url": "https://github.com/magiclen/node-datalith/issues"
    },
    "license": "MIT",
    "author": "Magic Len",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magiclen/node-datalith.git"
    },
    "files": [
        "lib"
    ],
    "type": "module",
    "types": "./lib/index.d.ts",
    "exports": "./lib/index.js",
    "scripts": {
        "test": "tsx --test",
        "clean": "rimraf lib",
        "build": "npm run clean && rslib build",
        "build:watch": "rslib build --watch",
        "demo": "npm run build && tsx examples/demo/server.ts",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "knip": "knip",
        "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run knip",
        "prepare": "node setup-git-hooks.mjs",
        "prepack": "npm run build",
        "prepublishOnly": "npm run check && npm run test",
        "typecheck": "tsc -p tsconfig.build.json --noEmit",
        "test:integration": "npm run build && tsx --test tests/integration/service.integration.ts"
    },
    "dependencies": {
        "fetch-helper-x": "^0.3.0"
    },
    "devDependencies": {
        "@rslib/core": "^1.0.1",
        "@types/node": "^26.6.4",
        "hls.js": "1.7.3",
        "knip": "^6.40.0",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "oxlint-tsgolint": "^7.0.2003",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=24"
    },
    "knip": {
        "entry": [
            "examples/demo/public/app.js",
            "tests/**/*.test.ts",
            "tests/integration/*.integration.ts"
        ]
    }
}
